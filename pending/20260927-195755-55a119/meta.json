{
  "job_id": "20260927-195755-55a119",
  "title": "\u0938\u093e\u0901\u092a \u0914\u0930 \u0938\u093e\u0927\u0941: \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0915\u0925\u093e",
  "script": "\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0928\u093e\u0917 \u0938\u093e\u0927\u0941 \u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0938\u093e\u0901\u092a \u0915\u094b \u0915\u094d\u092f\u094b\u0902 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902? \u092f\u0939 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948 \u091c\u094b \u0928\u0943\u0935\u0943\u0924\u094d\u0924\u093f \u0914\u0930 \u092e\u0930\u0923 \u0915\u0947 \u091a\u0915\u094d\u0930 \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u093e\u0927\u0941 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u093e\u0901\u092a \u0915\u0947 \u091c\u0940\u0935\u0928\u0915\u0932\u094d\u0932\u094b\u0932\u0940 \u0915\u0940 \u0924\u0930\u0939 \u0909\u0928\u0915\u0947 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0906\u0930\u0902\u092d \u092e\u0947\u0902 \u090f\u0915 \u0935\u0930\u094d\u091c\u093f\u0924 \u092a\u0925 \u091b\u0941\u092a\u093e \u0939\u0948\u0964 \u0935\u0947 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u092e\u0947\u0902 \u0909\u0938\u0947 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0938\u0947 \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0948\u0932\u0940\u092f \u092a\u093e\u0928\u0940 \u0938\u0947 \u0928\u0939\u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0938\u0930\u0932 \u0915\u0930\u094d\u092e \u0938\u0947 \u092e\u0928 \u0915\u094b \u0936\u093e\u0902\u0924\u093f, \u0936\u0930\u0940\u0930 \u0915\u094b \u092a\u0935\u093f\u0924\u094d\u0930\u0924\u093e \u0914\u0930 \u0906\u0924\u094d\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u0928\u0924\u093e \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938 \u0932\u0902\u092c\u0940 \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u094b \u0926\u0947\u0916\u0928\u093e, \u0938\u092e\u091d\u0928\u093e \u0914\u0930 \u0905\u092a\u0928\u093e\u0928\u093e \u0938\u092c\u0915\u094b \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0909\u0928\u094d\u0928\u0924\u093f \u0915\u093e \u092c\u093e\u0923 \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
  "caption": "\u0938\u093e\u0901\u092a \u0914\u0930 \u0938\u093e\u0927\u0941: \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0915\u0925\u093e\n\n\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u094b \u092a\u0924\u093e \u0939\u0948 \u0915\u093f \u0928\u093e\u0917 \u0938\u093e\u0927\u0941 \u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0938\u093e\u0901\u092a \u0915\u094b \u0915\u094d\u092f\u094b\u0902 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902? \u092f\u0939 \u090f\u0915 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948 \u091c\u094b \u0928\u0943\u0935\u0943\u0924\u094d\u0924\u093f \u0914\u0930 \u092e\u0930\u0923 \u0915\u0947 \u091a\u0915\u094d\u0930 \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u093e\u0927\u0941 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u093e\u0901\u092a \u0915\u0947 \u091c\u0940\u0935\u0928\u0915\u0932\u094d\u0932\u094b\u0932\u0940 \u0915\u0940 \u0924\u0930\u0939 \u0909\u0928\u0915\u0947 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0906\u0930\u0902\u092d \u092e\u0947\u0902 \u090f\u0915 \u0935\u0930\u094d\u091c\u093f\u0924 \u092a\u0925 \u091b\u0941\u092a\u093e \u0939\u0948\u0964 \u0935\u0947 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u092e\u0947\u0902 \u0909\u0938\u0947 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0938\u0947 \u0938\u093e\u092b\u093c \u0914\u0930 \u0924\u0948\u0932\u0940\u092f \u092a\u093e\u0928\u0940 \u0938\u0947 \u0928\u0939\u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0938\u0930\u0932 \u0915\u0930\u094d\u092e \u0938\u0947 \u092e\u0928 \u0915\u094b \u0936\u093e\u0902\u0924\u093f, \u0936\u0930\u0940\u0930 \u0915\u094b \u092a\u0935\u093f\u0924\u094d\u0930\u0924\u093e \u0914\u0930 \u0906\u0924\u094d\u092e\u093e \u0915\u094b \u0938\u092e\u093e\u0928\u0924\u093e \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938 \u0932\u0902\u092c\u0940 \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u094b \u0926\u0947\u0916\u0928\u093e, \u0938\u092e\u091d\u0928\u093e \u0914\u0930 \u0905\u092a\u0928\u093e\u0928\u093e \u0938\u092c\u0915\u094b \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0909\u0928\u094d\u0928\u0924\u093f \u0915\u093e \u092c\u093e\u0923 \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n\n#\u0928\u093e\u0917\u0938\u093e\u0927\u0941 #\u0938\u093e\u0901\u092a #\u092c\u094b\u0927 #\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915\u0924\u093e #\u0938\u093e\u0927\u0941\u091c\u0940\u0935\u0928 #\u092a\u0935\u093f\u0924\u094d\u0930\u091b\u0935\u093f #\u0906\u0924\u094d\u092e\u093e",
