{
  "job_id": "20260924-140325-426a12",
  "title": "\u091c\u094d\u092f\u094b\u0924\u093f\u0937 \u0915\u0948\u0938\u0947 \u0924\u092f \u0915\u0930\u0924\u093e \u0939\u0948 \u0924\u093e\u0930\u0940\u0916",
  "script": "\u0906\u0907\u090f \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u090f\u0915 \u0905\u0926\u094d\u092d\u0941\u0924 \u092c\u093e\u0924 \u0915\u0940\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0938\u091f\u0940\u0915 \u0924\u093e\u0930\u0940\u0916\u0947\u0902 \u0938\u0942\u0930\u094d\u092f, \u091a\u0902\u0926\u094d\u0930\u092e\u093e \u0914\u0930 \u092c\u0943\u0939\u0938\u094d\u092a\u0924\u093f \u0915\u0940 \u0930\u093e\u0936\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0924\u092f \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092f\u0939 \u092d\u0940 \u0924\u092f \u0915\u0930\u0924\u0940 \u0939\u0948 \u0915\u093f \u0915\u093f\u0938\u0940 \u091a\u0915\u094d\u0930 \u092e\u0947\u0902 \u0915\u0941\u0902\u092d \u0915\u093f\u0938 \u0936\u0939\u0930 \u092e\u0947\u0902 \u0932\u0917\u0947\u0917\u093e\u0964 \u0907\u0938\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u093f\u0938\u0940 \u0924\u092f \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0924\u093e\u0930\u0940\u0916 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0906\u0924\u093e, \u092c\u0932\u094d\u0915\u093f \u0907\u0938\u0915\u0940 \u0917\u0923\u0928\u093e \u0938\u093e\u0932\u094b\u0902 \u092a\u0939\u0932\u0947 \u0915\u0930\u0928\u0940 \u092a\u0921\u093c\u0924\u0940 \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964",
  "caption": "\u091c\u094d\u092f\u094b\u0924\u093f\u0937 \u0915\u0948\u0938\u0947 \u0924\u092f \u0915\u0930\u0924\u093e \u0939\u0948 \u0924\u093e\u0930\u0940\u0916\n\n\u0906\u0907\u090f \u092c\u093e\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u090f\u0915 \u0905\u0926\u094d\u092d\u0941\u0924 \u092c\u093e\u0924 \u0915\u0940\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0938\u091f\u0940\u0915 \u0924\u093e\u0930\u0940\u0916\u0947\u0902 \u0938\u0942\u0930\u094d\u092f, \u091a\u0902\u0926\u094d\u0930\u092e\u093e \u0914\u0930 \u092c\u0943\u0939\u0938\u094d\u092a\u0924\u093f \u0915\u0940 \u0930\u093e\u0936\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0924\u092f \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092f\u0939 \u092d\u0940 \u0924\u092f \u0915\u0930\u0924\u0940 \u0939\u0948 \u0915\u093f \u0915\u093f\u0938\u0940 \u091a\u0915\u094d\u0930 \u092e\u0947\u0902 \u0915\u0941\u0902\u092d \u0915\u093f\u0938 \u0936\u0939\u0930 \u092e\u0947\u0902 \u0932\u0917\u0947\u0917\u093e\u0964 \u0907\u0938\u0940 \u0935\u091c\u0939 \u0938\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u093f\u0938\u0940 \u0924\u092f \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0924\u093e\u0930\u0940\u0916 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0906\u0924\u093e, \u092c\u0932\u094d\u0915\u093f \u0907\u0938\u0915\u0940 \u0917\u0923\u0928\u093e \u0938\u093e\u0932\u094b\u0902 \u092a\u0939\u0932\u0947 \u0915\u0930\u0928\u0940 \u092a\u0921\u093c\u0924\u0940 \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\n#\u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f #KumbhMela #\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e",
