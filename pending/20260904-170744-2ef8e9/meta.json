  "title": "\u0917\u0902\u0917\u093e \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935",
  "script": "\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0915\u0908 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0930\u0938\u094d\u092e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u092e\u094b\u0915\u094d\u0937 \u092a\u093e\u0928\u0947 \u0915\u093e \u090f\u0915 \u0905\u0928\u092e\u094b\u0932 \u0905\u0935\u0938\u0930 \u0939\u0948\u0964 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0938\u093f\u0930\u094d\u092b \u0909\u0938\u0940 \u0936\u0941\u092d \u0915\u094d\u0937\u0923 \u092e\u0947\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u0947\u0936-\u0935\u093f\u0926\u0947\u0936 \u0938\u0947 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0930\u0915\u0947 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0917\u0902\u0917\u093e \u092e\u0947\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u091c\u0928\u094d\u092e\u094b\u0902-\u091c\u0928\u094d\u092e\u094b\u0902 \u0915\u0947 \u092a\u093e\u092a \u0927\u0941\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "caption": "\u0917\u0902\u0917\u093e \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092e\u0939\u0924\u094d\u0935\n\n\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0915\u0908 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u0930\u0938\u094d\u092e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u092e\u094b\u0915\u094d\u0937 \u092a\u093e\u0928\u0947 \u0915\u093e \u090f\u0915 \u0905\u0928\u092e\u094b\u0932 \u0905\u0935\u0938\u0930 \u0939\u0948\u0964 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0938\u093f\u0930\u094d\u092b \u0909\u0938\u0940 \u0936\u0941\u092d \u0915\u094d\u0937\u0923 \u092e\u0947\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u0947\u0936-\u0935\u093f\u0926\u0947\u0936 \u0938\u0947 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0930\u0915\u0947 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0917\u0902\u0917\u093e \u092e\u0947\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u091c\u0928\u094d\u092e\u094b\u0902-\u091c\u0928\u094d\u092e\u094b\u0902 \u0915\u0947 \u092a\u093e\u092a \u0927\u0941\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u0