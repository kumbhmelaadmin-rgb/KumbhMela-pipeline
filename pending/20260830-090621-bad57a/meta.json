{
  "job_id": "20260830-090621-bad57a",
  "title": "\u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u092e\u0939\u0924\u094d\u0935",
  "script": "\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0907\u0938\u0915\u0940 \u0936\u0941\u092d \u0924\u093f\u0925\u093f\u092f\u093e\u0902 \u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092e\u0939\u0940\u0928\u094b\u0902 \u092f\u093e \u0938\u093e\u0932\u094b\u0902 \u092a\u0939\u0932\u0947 \u0924\u092f \u0915\u0930 \u0932\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u093e \u0938\u092c\u0938\u0947 \u092a\u0935\u093f\u0924\u094d\u0930 \u0938\u094d\u0928\u093e\u0928 \u0905\u0928\u0941\u0937\u094d\u0920\u093e\u0928 \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u0938\u092e\u092f \u091c\u094d\u092f\u094b\u0924\u093f\u0937\u0940\u092f \u0917\u0923\u0928\u093e \u0938\u0947 \u0924\u092f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u093e\u0917\u093e \u0938\u093e\u0927\u0941 \u0914\u0930 \u0905\u0916\u093e\u0921\u093c\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0915\u0930\u094b\u0921\u093c\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0909\u0938\u0940 \u092a\u0941\u0923\u094d\u092f \u0915\u0940 \u0906\u0936\u093e \u092e\u0947\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0939\u0948 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 - \u0906\u0938\u094d\u0925\u093e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0910\u0938\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u0924\u0930 \u091c\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0939\u0940\u0902 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964",
  "caption": "\u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u092e\u0939\u0924\u094d\u0935\n\n\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0907\u0938\u0915\u0940 \u0936\u0941\u092d \u0924\u093f\u0925\u093f\u092f\u093e\u0902 \u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092e\u0939\u0940\u0928\u094b\u0902 \u092f\u093e \u0938\u093e\u0932\u094b\u0902 \u092a\u0939\u0932\u0947 \u0924\u092f \u0915\u0930 \u0932\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u093e \u0938\u092c\u0938\u0947 \u092a\u0935\u093f\u0924\u094d\u0930 \u0938\u094d\u0928\u093e\u0928 \u0905\u0928\u0941\u0937\u094d\u0920\u093e\u0928 \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u0938\u092e\u092f \u091c\u094d\u092f\u094b\u0924\u093f\u0937\u0940\u092f \u0917\u0923\u0928\u093e \u0938\u0947 \u0924\u092f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0928\u093e\u0917\u093e \u0938\u093e\u0927\u0941 \u0914\u0930 \u0905\u0916\u093e\u0921\u093c\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0915\u0930\u094b\u0921\u093c\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0909\u0938\u0940 \u092a\u0941\u0923\u094d\u092f \u0915\u0940 \u0906\u0936\u093e \u092e\u0947\u0902 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0939\u0948 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 - \u0906\u0938\u094d\u0925\u093e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0910\u0938\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u0924\u0930 \u091c\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0939\u0940\u0902 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964\n\n#KumbhMela #\u0917\u0902\u0917\u093e #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f #\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e",
