{
  "job_id": "20260829-170506-08bd35",
  "title": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0909\u0924\u094d\u092a\u0924\u094d\u0924\u093f",
  "script": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u0940 \u092c\u093e\u0924 \u091c\u094b \u0936\u093e\u092f\u0926 \u0906\u092a \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u091c\u0921\u093c\u0947\u0902 \u0939\u091c\u093e\u0930 \u0938\u093e\u0932 \u0938\u0947 \u092d\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0939\u0948\u0902, \u091c\u094b \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0914\u0930 \u0905\u0938\u0941\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0905\u092e\u0943\u0924 \u0915\u0932\u0936 \u0915\u0947 \u0932\u093f\u090f \u0939\u0941\u090f \u0938\u0902\u0918\u0930\u094d\u0937 \u0915\u0940 \u0915\u0925\u093e \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0939\u0948\u0902\u0964 \u0906\u0920\u0935\u0940\u0902 \u0938\u0926\u0940 \u0915\u0947 \u092e\u0939\u093e\u0928 \u0926\u093e\u0930\u094d\u0936\u0928\u093f\u0915 \u0906\u0926\u093f \u0936\u0902\u0915\u0930\u093e\u091a\u093e\u0930\u094d\u092f \u0915\u094b \u0905\u0915\u094d\u0938\u0930 \u0938\u0902\u0924\u094b\u0902 \u0915\u0947 \u0907\u0928 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u0915\u094b \u090f\u0915 \u0938\u0902\u0917\u0920\u093f\u0924 \u092a\u0930\u094d\u0935 \u0915\u093e \u0930\u0942\u092a \u0926\u0947\u0928\u0947 \u0915\u093e \u0936\u094d\u0930\u0947\u092f \u0926\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0938 \u0905\u092e\u0943\u0924 \u0915\u0940 \u0915\u0941\u091b \u092c\u0942\u0902\u0926\u0947\u0902 \u0927\u0930\u0924\u0940 \u092a\u0930 \u091a\u093e\u0930 \u091c\u0917\u0939\u094b\u0902 \u092a\u0930 \u0917\u093f\u0930\u0940\u0902 - \u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c, \u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930, \u0909\u091c\u094d\u091c\u0948\u0928 \u0914\u0930 \u0928\u093e\u0938\u093f\u0915 - \u0907\u0938\u0940\u0932\u093f\u090f \u092f\u0939 \u092e\u0947\u0932\u093e \u0907\u0928\u094d\u0939\u0940\u0902 \u091a\u093e\u0930 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0918\u0942\u092e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0909\u0924\u094d\u092a\u0924\u094d\u0924\u093f\n\n\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u0940 \u092c\u093e\u0924 \u091c\u094b \u0936\u093e\u092f\u0926 \u0906\u092a \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u091c\u0921\u093c\u0947\u0902 \u0939\u091c\u093e\u0930 \u0938\u093e\u0932 \u0938\u0947 \u092d\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0939\u0948\u0902, \u091c\u094b \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0914\u0930 \u0905\u0938\u0941\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0905\u092e\u0943\u0924 \u0915\u0932\u0936 \u0915\u0947 \u0932\u093f\u090f \u0939\u0941\u090f \u0938\u0902\u0918\u0930\u094d\u0937 \u0915\u0940 \u0915\u0925\u093e \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0939\u0948\u0902\u0964 \u0906\u0920\u0935\u0940\u0902 \u0938\u0926\u0940 \u0915\u0947 \u092e\u0939\u093e\u0928 \u0926\u093e\u0930\u094d\u0936\u0928\u093f\u0915 \u0906\u0926\u093f \u0936\u0902\u0915\u0930\u093e\u091a\u093e\u0930\u094d\u092f \u0915\u094b \u0905\u0915\u094d\u0938\u0930 \u0938\u0902\u0924\u094b\u0902 \u0915\u0947 \u0907\u0928 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u0915\u094b \u090f\u0915 \u0938\u0902\u0917\u0920\u093f\u0924 \u092a\u0930\u094d\u0935 \u0915\u093e \u0930\u0942\u092a \u0926\u0947\u0928\u0947 \u0915\u093e \u0936\u094d\u0930\u0947\u092f \u0926\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0909\u0938 \u0905\u092e\u0943\u0924 \u0915\u0940 \u0915\u0941\u091b \u092c\u0942\u0902\u0926\u0947\u0902 \u0927\u0930\u0924\u0940 \u092a\u0930 \u091a\u093e\u0930 \u091c\u0917\u0939\u094b\u0902 \u092a\u0930 \u0917\u093f\u0930\u0940\u0902 - \u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c, \u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930, \u0909\u091c\u094d\u091c\u0948\u0928 \u0914\u0930 \u0928\u093e\u0938\u093f\u0915 - \u0907\u0938\u0940\u0932\u093f\u090f \u092f\u0939 \u092e\u0947\u0932\u093e \u0907\u0928\u094d\u0939\u0940\u0902 \u091a\u093e\u0930 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0918\u0942\u092e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n#\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u0917\u0902\u0917\u093e #\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e #\u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f",
