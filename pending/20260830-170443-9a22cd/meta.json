{
  "job_id": "20260830-170443-9a22cd",
  "title": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u093e \u090f\u0915 \u092e\u093f\u0925\u0915",
  "script": "\u092f\u0939 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0924\u0925\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964 \u092c\u0939\u0941\u0924 \u0938\u0947 \u0932\u094b\u0917 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 \u091c\u0917\u0939 \u092c\u093e\u0930\u0939 \u0938\u093e\u0932 \u092e\u0947\u0902 \u0906\u0924\u093e \u0939\u0948 - \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u0930 \u091b\u0939 \u0938\u093e\u0932 \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e '\u0905\u0930\u094d\u0927 \u0915\u0941\u0902\u092d' \u092d\u0940 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u092e \u0927\u093e\u0930\u0923\u093e \u0915\u0947 \u0935\u093f\u092a\u0930\u0940\u0924, \u092f\u0939 \u0915\u094b\u0908 \u090f\u0915 \u0926\u093f\u0928 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092f\u0939 \u0939\u092b\u094d\u0924\u094b\u0902 \u0924\u0915 \u091a\u0932\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0915\u0908 \u0905\u0932\u0917 \u0938\u094d\u0928\u093e\u0928 \u0924\u093f\u0925\u093f\u092f\u093e\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902, \u0939\u0930 \u090f\u0915 \u0915\u093e \u0905\u092a\u0928\u093e \u091c\u094d\u092f\u094b\u0924\u093f\u0937\u0940\u092f \u092e\u0939\u0924\u094d\u0935 \u0939\u0948\u0964 \u092f\u0939 \u092d\u0940 \u090f\u0915 \u0906\u092e \u092d\u094d\u0930\u092e \u0939\u0948 \u0915\u093f \u092f\u0939\u093e\u0902 \u0938\u093f\u0930\u094d\u092b \u0939\u093f\u0902\u0926\u0942 \u0924\u092a\u0938\u094d\u0935\u0940 \u0906\u0924\u0947 \u0939\u0948\u0902 - \u0905\u0938\u0932 \u092e\u0947\u0902 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 \u0927\u0930\u094d\u092e \u0914\u0930 \u0939\u0930 \u091c\u0917\u0939 \u0938\u0947 \u0906\u090f \u092f\u093e\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0914\u0930 \u0936\u094b\u0927\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0939\u0948 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 - \u0906\u0938\u094d\u0925\u093e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0910\u0938\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u0924\u0930 \u091c\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0939\u0940\u0902 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u093e \u090f\u0915 \u092e\u093f\u0925\u0915\n\n\u092f\u0939 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0924\u0925\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964 \u092c\u0939\u0941\u0924 \u0938\u0947 \u0932\u094b\u0917 \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 \u091c\u0917\u0939 \u092c\u093e\u0930\u0939 \u0938\u093e\u0932 \u092e\u0947\u0902 \u0906\u0924\u093e \u0939\u0948 - \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u0930 \u091b\u0939 \u0938\u093e\u0932 \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u093e '\u0905\u0930\u094d\u0927 \u0915\u0941\u0902\u092d' \u092d\u0940 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u092e \u0927\u093e\u0930\u0923\u093e \u0915\u0947 \u0935\u093f\u092a\u0930\u0940\u0924, \u092f\u0939 \u0915\u094b\u0908 \u090f\u0915 \u0926\u093f\u0928 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092f\u0939 \u0939\u092b\u094d\u0924\u094b\u0902 \u0924\u0915 \u091a\u0932\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0915\u0908 \u0905\u0932\u0917 \u0938\u094d\u0928\u093e\u0928 \u0924\u093f\u0925\u093f\u092f\u093e\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902, \u0939\u0930 \u090f\u0915 \u0915\u093e \u0905\u092a\u0928\u093e \u091c\u094d\u092f\u094b\u0924\u093f\u0937\u0940\u092f \u092e\u0939\u0924\u094d\u0935 \u0939\u0948\u0964 \u092f\u0939 \u092d\u0940 \u090f\u0915 \u0906\u092e \u092d\u094d\u0930\u092e \u0939\u0948 \u0915\u093f \u092f\u0939\u093e\u0902 \u0938\u093f\u0930\u094d\u092b \u0939\u093f\u0902\u0926\u0942 \u0924\u092a\u0938\u094d\u0935\u0940 \u0906\u0924\u0947 \u0939\u0948\u0902 - \u0905\u0938\u0932 \u092e\u0947\u0902 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 \u0927\u0930\u094d\u092e \u0914\u0930 \u0939\u0930 \u091c\u0917\u0939 \u0938\u0947 \u0906\u090f \u092f\u093e\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0914\u0930 \u0936\u094b\u0927\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0939\u0948 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 - \u0906\u0938\u094d\u0925\u093e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0910\u0938\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u0924\u0930 \u091c\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0939\u0940\u0902 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964\n\n#\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e #\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915\u0924\u093e #KumbhMela #\u0917\u0902\u0917\u093e #\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e",
