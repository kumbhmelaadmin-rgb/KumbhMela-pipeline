{
  "job_id": "20260922-091057-7a0531",
  "title": "\u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u092a\u0935\u093f\u0924\u094d\u0930 \u0930\u0939\u0938\u094d\u092f",
  "script": "\u0915\u0941\u0902\u092d \u0915\u0947 \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u092e\u0947\u0902 \u092a\u093e\u0928\u0940 \u0915\u0940 \u090f\u0915 \u0905\u0928\u0942\u0920\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948 \u2013 \u092f\u0939 \u092a\u0935\u093f\u0924\u094d\u0930 \u091c\u0932 \u0939\u0948, \u091c\u093f\u0938\u0915\u0940 \u092c\u0942\u0901\u0926\u0947\u0902 \u0938\u092d\u0940 \u092a\u093e\u092a\u094b\u0902 \u0915\u094b \u0927\u094b \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u0925\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0907\u0938 \u091c\u0932 \u092e\u0947\u0902 33 \u0935\u0930\u094d\u0937 \u0915\u0940 \u0938\u093e\u0927\u0928\u093e \u0915\u093e \u0938\u093e\u0915\u094d\u0937\u093e\u0924 \u092b\u0932 \u092a\u094d\u0930\u0915\u091f \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0938\u092e\u094d\u0930\u093e\u091f \u0935 \u092b\u093c\u0948\u0938\u093e\u0932\u093e \u0907\u0938 \u0938\u094d\u0928\u093e\u0928 \u0915\u094b \u0905\u0928\u092e\u094b\u0932 \u0930\u093e\u091c\u0938\u0940 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u092d\u0940 \u0917\u0941\u0930\u0941\u0924\u094d\u0935\u093e\u0915\u0930\u094d\u0937\u0923 \u0915\u0940 \u0924\u0930\u0939 \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0930\u094b\u091c\u093c \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0906\u092a\u0915\u094b \u092e\u093e\u0928\u0938\u093f\u0915 \u0936\u093e\u0928\u094d\u0924\u093f, \u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0924\u093e\u091c\u0917\u0940 \u0914\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0909\u0928\u094d\u0928\u0924\u093f \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u093e\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0926\u093f\u0928 \u0915\u0940 \u092d\u0940\u0921\u093c \u0915\u0947 \u092c\u0940\u091a, \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0906\u092a\u0915\u0947 \u092d\u0940\u0924\u0930 \u091b\u093f\u092a\u0940 \u0926\u093f\u0935\u094d\u092f\u0924\u093e \u0915\u094b \u091c\u093e\u0917\u0943\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
  "caption": "\u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u093e \u092a\u0935\u093f\u0924\u094d\u0930 \u0930\u0939\u0938\u094d\u092f\n\n\u0915\u0941\u0902\u092d \u0915\u0947 \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u092e\u0947\u0902 \u092a\u093e\u0928\u0940 \u0915\u0940 \u090f\u0915 \u0905\u0928\u0942\u0920\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948 \u2013 \u092f\u0939 \u092a\u0935\u093f\u0924\u094d\u0930 \u091c\u0932 \u0939\u0948, \u091c\u093f\u0938\u0915\u0940 \u092c\u0942\u0901\u0926\u0947\u0902 \u0938\u092d\u0940 \u092a\u093e\u092a\u094b\u0902 \u0915\u094b \u0927\u094b \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0915\u0925\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0907\u0938 \u091c\u0932 \u092e\u0947\u0902 33 \u0935\u0930\u094d\u0937 \u0915\u0940 \u0938\u093e\u0927\u0928\u093e \u0915\u093e \u0938\u093e\u0915\u094d\u0937\u093e\u0924 \u092b\u0932 \u092a\u094d\u0930\u0915\u091f \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0938\u092e\u094d\u0930\u093e\u091f \u0935 \u092b\u093c\u0948\u0938\u093e\u0932\u093e \u0907\u0938 \u0938\u094d\u0928\u093e\u0928 \u0915\u094b \u0905\u0928\u092e\u094b\u0932 \u0930\u093e\u091c\u0938\u0940 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u092d\u0940 \u0917\u0941\u0930\u0941\u0924\u094d\u0935\u093e\u0915\u0930\u094d\u0937\u0923 \u0915\u0940 \u0924\u0930\u0939 \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0930\u094b\u091c\u093c \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0906\u092a\u0915\u094b \u092e\u093e\u0928\u0938\u093f\u0915 \u0936\u093e\u0928\u094d\u0924\u093f, \u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0924\u093e\u091c\u0917\u0940 \u0914\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0909\u0928\u094d\u0928\u0924\u093f \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u093e\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0926\u093f\u0928 \u0915\u0940 \u092d\u0940\u0921\u093c \u0915\u0947 \u092c\u0940\u091a, \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0906\u092a\u0915\u0947 \u092d\u0940\u0924\u0930 \u091b\u093f\u092a\u0940 \u0926\u093f\u0935\u094d\u092f\u0924\u093e \u0915\u094b \u091c\u093e\u0917\u0943\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964\n\n#KumbhMela #ShahiSnan #RoyalBath #Purification #SpiritualJourney #Tradition #\u0927\u0930\u094d\u092e #\u0935\u093f\u0936\u094d\u0935\u093e\u0938",
