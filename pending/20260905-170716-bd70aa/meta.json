{
  "job_id": "20260905-170716-bd70aa",
  "title": "\u0915\u0941\u0902\u092d \u0915\u093e \u0938\u0902\u0926\u0947\u0936",
  "script": "\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u092f\u0939 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0939\u0930 \u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u0915\u0947 \u0932\u094b\u0917 - \u0905\u092e\u0940\u0930, \u0917\u0930\u0940\u092c, \u0935\u093f\u0926\u094d\u0935\u093e\u0928, \u0924\u092a\u0938\u094d\u0935\u0940 - \u0938\u092c \u090f\u0915 \u0938\u093e\u0925, \u092c\u0930\u093e\u092c\u0930\u0940 \u0938\u0947, \u0915\u0941\u091b \u092c\u0921\u093c\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0907\u0915\u091f\u094d\u0920\u093e \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0915\u093e \u092e\u0942\u0932 \u0938\u0902\u0926\u0947\u0936 \u092f\u0939\u0940 \u0939\u0948 \u0915\u093f \u0936\u0941\u0926\u094d\u0927\u093f \u0938\u093f\u0930\u094d\u092b \u0936\u0930\u0940\u0930 \u0915\u0940 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0909\u0928 \u091a\u0940\u091c\u093c\u094b\u0902 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u0905\u0935\u0938\u0930 \u092d\u0940 \u0939\u0948 \u091c\u094b \u0905\u092c \u0939\u092e\u093e\u0930\u0947 \u0915\u093e\u092e \u0915\u0940 \u0928\u0939\u0940\u0902 \u0930\u0939\u0940\u0902\u0964 \u0915\u0930\u094b\u0921\u093c\u094b\u0902 \u0932\u094b\u0917 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0938\u0947 \u0915\u0941\u091b \u092d\u094c\u0924\u093f\u0915 \u0932\u0947\u0915\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u091c\u0940\u0935\u0928 \u0915\u093e \u090f\u0915 \u0928\u092f\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0932\u0947\u0915\u0930 \u0932\u094c\u091f\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u0915\u093e \u0938\u0902\u0926\u0947\u0936\n\n\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u092f\u0939 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0939\u0930 \u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u0915\u0947 \u0932\u094b\u0917 - \u0905\u092e\u0940\u0930, \u0917\u0930\u0940\u092c, \u0935\u093f\u0926\u094d\u0935\u093e\u0928, \u0924\u092a\u0938\u094d\u0935\u0940 - \u0938\u092c \u090f\u0915 \u0938\u093e\u0925, \u092c\u0930\u093e\u092c\u0930\u0940 \u0938\u0947, \u0915\u0941\u091b \u092c\u0921\u093c\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0907\u0915\u091f\u094d\u0920\u093e \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0915\u093e \u092e\u0942\u0932 \u0938\u0902\u0926\u0947\u0936 \u092f\u0939\u0940 \u0939\u0948 \u0915\u093f \u0936\u0941\u0926\u094d\u0927\u093f \u0938\u093f\u0930\u094d\u092b \u0936\u0930\u0940\u0930 \u0915\u0940 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0909\u0928 \u091a\u0940\u091c\u093c\u094b\u0902 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u0905\u0935\u0938\u0930 \u092d\u0940 \u0939\u0948 \u091c\u094b \u0905\u092c \u0939\u092e\u093e\u0930\u0947 \u0915\u093e\u092e \u0915\u0940 \u0928\u0939\u0940\u0902 \u0930\u0939\u0940\u0902\u0964 \u0915\u0930\u094b\u0921\u093c\u094b\u0902 \u0932\u094b\u0917 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0938\u0947 \u0915\u0941\u091b \u092d\u094c\u0924\u093f\u0915 \u0932\u0947\u0915\u0930 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u091c\u0940\u0935\u0928 \u0915\u093e \u090f\u0915 \u0928\u092f\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0932\u0947\u0915\u0930 \u0932\u094c\u091f\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n#\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e #IncredibleIndia #\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915\u0924\u093e #\u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c #\u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930",
