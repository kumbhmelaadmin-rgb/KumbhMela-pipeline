  "title": "\u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0927\u0930\u094b\u0939\u0930 \u092c\u0928\u093e \u0915\u0941\u0902\u092d",
  "script": "\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0907\u0938\u0947 \u0907\u0938\u0915\u0947 \u0935\u093f\u0936\u093e\u0932 \u0938\u094d\u0924\u0930, \u0935\u093f\u0935\u093f\u0927 \u0905\u0928\u0941\u0937\u094d\u0920\u093e\u0928\u094b\u0902 \u0914\u0930 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u093e\u0930\u094d\u0935\u092d\u094c\u092e\u093f\u0915 \u092d\u093e\u0908\u091a\u093e\u0930\u0947 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0926\u0940 \u0917\u0908\u0964 \u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0928\u0947 \u0916\u093e\u0938\u0924\u094c\u0930 \u092a\u0930 \u0907\u0938 \u092c\u093e\u0924 \u0915\u094b \u0938\u0930\u093e\u0939\u093e \u0915\u093f \u092f\u0939\u093e\u0902 \u0907\u0924\u0928\u0940 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u093e\u0927\u0941 \u092a\u0930\u0902\u092a\u0930\u093e\u090f\u0902 \u0936\u093e\u0902\u0924\u093f \u0938\u0947 \u090f\u0915 \u0938\u093e\u0925 \u092e\u094c\u091c\u0942\u0926 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964 2017 \u092e\u0947\u0902 \u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u094b \u092e\u093e\u0928\u0935\u0924\u093e \u0915\u0940 \u0905\u092e\u0942\u0930\u094d\u0924 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0927\u0930\u094b\u0939\u0930 \u0915\u0940 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u092f\u093e\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964",
  "caption": "\u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0927\u0930\u094b\u0939\u0930 \u092c\u0928\u093e \u0915\u0941\u0902\u092d\n\n\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0907\u0938\u0947 \u0907\u0938\u0915\u0947 \u0935\u093f\u0936\u093e\u0932 \u0938\u094d\u0924\u0930, \u0935\u093f\u0935\u093f\u0927 \u0905\u0928\u0941\u0937\u094d\u0920\u093e\u0928\u094b\u0902 \u0914\u0930 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u093e\u0930\u094d\u0935\u092d\u094c\u092e\u093f\u0915 \u092d\u093e\u0908\u091a\u093e\u0930\u0947 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u0926\u0940 \u0917\u0908\u0964 \u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0928\u0947 \u0916\u093e\u0938\u0924\u094c\u0930 \u092a\u0930 \u0907\u0938 \u092c\u093e\u0924 \u0915\u094b \u0938\u0930\u093e\u0939\u093e \u0915\u093f \u092f\u0939\u093e\u0902 \u0907\u0924\u0928\u0940 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u093e\u0927\u0941 \u092a\u0930\u0902\u092a\u0930\u093e\u090f\u0902 \u0936\u093e\u0902\u0924\u093f \u0938\u0947 \u090f\u0915 \u0938\u093e\u0925 \u092e\u094c\u091c\u0942\u0926 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964 2017 \u092e\u0947\u0902 \u092f\u0942\u0928\u0947\u0938\u094d\u0915\u094b \u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u094b \u092e\u093e\u0928\u0935\u0924\u093e \u0915\u0940 \u0905\u092e\u0942\u0930\u094d\u0924 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u0927\u0930\u094b\u0939\u0930 \u0915\u0940 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u092f\u093e\u0964 \u0939