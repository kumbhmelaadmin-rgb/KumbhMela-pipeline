{
  "job_id": "20260904-091116-f07546",
  "title": "\u0915\u0941\u0902\u092d \u0915\u093e \u0932\u0902\u0917\u0930",
  "script": "\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u092f\u0947 \u0930\u0938\u094b\u0908 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u094b\u0902 \u0914\u0930 \u0926\u093e\u0928 \u0938\u0947 \u091a\u0932\u0924\u0940 \u0939\u0948\u0902, \u091c\u094b \u0907\u0938 \u092a\u0930\u094d\u0935 \u0915\u0940 \u0928\u093f\u0903\u0938\u094d\u0935\u093e\u0930\u094d\u0925 \u0938\u0947\u0935\u093e \u092d\u093e\u0935\u0928\u093e \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0940 \u092d\u094b\u091c\u0928 \u0905\u092d\u093f\u092f\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0932\u0902\u0917\u0930 \u092f\u093e\u0928\u0940 \u092e\u0941\u092b\u094d\u0924 \u0938\u093e\u092e\u0941\u0926\u093e\u092f\u093f\u0915 \u0930\u0938\u094b\u0908 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u092e\u0947\u0902 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0932\u093e\u0916\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u094b \u092d\u094b\u091c\u0928 \u0915\u0930\u093e\u0924\u0940 \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0936\u0941\u0932\u094d\u0915 \u0915\u0947\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u0915\u093e \u0932\u0902\u0917\u0930\n\n\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u092f\u0947 \u0930\u0938\u094b\u0908 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0915\u094b\u0902 \u0914\u0930 \u0926\u093e\u0928 \u0938\u0947 \u091a\u0932\u0924\u0940 \u0939\u0948\u0902, \u091c\u094b \u0907\u0938 \u092a\u0930\u094d\u0935 \u0915\u0940 \u0928\u093f\u0903\u0938\u094d\u0935\u093e\u0930\u094d\u0925 \u0938\u0947\u0935\u093e \u092d\u093e\u0935\u0928\u093e \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0947 \u0938\u094d\u0935\u092f\u0902\u0938\u0947\u0935\u0940 \u092d\u094b\u091c\u0928 \u0905\u092d\u093f\u092f\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0932\u0902\u0917\u0930 \u092f\u093e\u0928\u0940 \u092e\u0941\u092b\u094d\u0924 \u0938\u093e\u092e\u0941\u0926\u093e\u092f\u093f\u0915 \u0930\u0938\u094b\u0908 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u092e\u0947\u0902 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0932\u093e\u0916\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941\u0913\u0902 \u0915\u094b \u092d\u094b\u091c\u0928 \u0915\u0930\u093e\u0924\u0940 \u0939\u0948, \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0936\u0941\u0932\u094d\u0915 \u0915\u0947\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938