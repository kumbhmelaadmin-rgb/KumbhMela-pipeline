{
  "job_id": "20260924-201526-2aac49",
  "title": "\u0936\u0928\u093f \u0917\u094d\u0930\u0939 \u0914\u0930 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u0940 \u0924\u093f\u0925\u093f",
  "script": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u0940 \u0924\u093f\u0925\u093f \u0915\u093e \u092e\u093e\u092a\u0915 \u0938\u092c\u0938\u0947 \u092d\u0935\u094d\u092f \u0917\u094d\u0930\u0939: \u0936\u0928\u093f! \u0939\u0930 112 \u0935\u0930\u094d\u0937\u094b\u0902 \u092e\u0947\u0902 \u0936\u0928\u093f \u0905\u092a\u0928\u0947 \u092e\u0942\u0932\u0917\u094d\u0930\u0939 \u092e\u0915\u0930 \u0930\u093e\u0936\u093f \u092e\u0947\u0902 \u0932\u094c\u091f\u0924\u093e \u0939\u0948, \u0914\u0930 \u0924\u092d\u0940 \u0927\u093e\u0930\u093e \u0938\u0941\u0935\u0930\u094d\u0923 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0932\u093e\u0916\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u090f\u0915\u0924\u094d\u0930 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u092c \u0936\u0928\u093f \u0936\u0942\u0928\u094d\u092f (\u0936\u0942\u0928\u094d\u092f \u092a\u0930\u0924\u093e\u0930) \u0915\u0940 \u090a\u0930\u094d\u091c\u093e \u092d\u0947\u091c\u0924\u093e \u0939\u0948, \u0924\u092c \u0924\u0902\u0924\u094d\u0930\u0927\u093e\u0930\u093e \u0915\u093e \u0938\u0902\u0915\u094d\u0930\u093e\u0902\u0924\u093f \u0906\u0930\u092e\u094d\u092d \u0939\u094b\u0924\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0914\u0930 \u092e\u0939\u093e\u0928\u0917\u0930\u0940\u092f \u092e\u0928\u0941\u0937\u094d\u092f \u090f\u0915 \u0938\u093e\u0925 \u0905\u0917\u0932\u0947 \u0935\u0930\u094d\u0923 \u092e\u0947\u0932\u093e \u0915\u094b \u092d\u0947\u0902\u091f \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0917\u094d\u0930\u0939 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, 2024 \u092e\u0947\u0902 \u0936\u0928\u093f \u0928\u0947 \u092e\u0915\u0930 \u0915\u094b \u091b\u0941\u0906, \u0914\u0930 \u0907\u0938 \u0935\u091c\u0939 \u0938\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0938\u093f\u092f\u093e\u0928\u0940 \u0915\u0947 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0906 \u0917\u092f\u093e\u0964",
  "caption": "\u0936\u0928\u093f \u0917\u094d\u0930\u0939 \u0914\u0930 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u0940 \u0924\u093f\u0925\u093f\n\n\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u0940 \u0924\u093f\u0925\u093f \u0915\u093e \u092e\u093e\u092a\u0915 \u0938\u092c\u0938\u0947 \u092d\u0935\u094d\u092f \u0917\u094d\u0930\u0939: \u0936\u0928\u093f! \u0939\u0930 112 \u0935\u0930\u094d\u0937\u094b\u0902 \u092e\u0947\u0902 \u0936\u0928\u093f \u0905\u092a\u0928\u0947 \u092e\u0942\u0932\u0917\u094d\u0930\u0939 \u092e\u0915\u0930 \u0930\u093e\u0936\u093f \u092e\u0947\u0902 \u0932\u094c\u091f\u0924\u093e \u0939\u0948, \u0914\u0930 \u0924\u092d\u0940 \u0927\u093e\u0930\u093e \u0938\u0941\u0935\u0930\u094d\u0923 \u0939\u094b\u0924\u0940 \u0939\u0948, \u0932\u093e\u0916\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u090f\u0915\u0924\u094d\u0930 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u092c \u0936\u0928\u093f \u0936\u0942\u0928\u094d\u092f (\u0936\u0942\u0928\u094d\u092f \u092a\u0930\u0924\u093e\u0930) \u0915\u0940 \u090a\u0930\u094d\u091c\u093e \u092d\u0947\u091c\u0924\u093e \u0939\u0948, \u0924\u092c \u0924\u0902\u0924\u094d\u0930\u0927\u093e\u0930\u093e \u0915\u093e \u0938\u0902\u0915\u094d\u0930\u093e\u0902\u0924\u093f \u0906\u0930\u092e\u094d\u092d \u0939\u094b\u0924\u093e \u0939\u0948, \u0914\u0930 \u0939\u0930 \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0914\u0930 \u092e\u0939\u093e\u0928\u0917\u0930\u0940\u092f \u092e\u0928\u0941\u0937\u094d\u092f \u090f\u0915 \u0938\u093e\u0925 \u0905\u0917\u0932\u0947 \u0935\u0930\u094d\u0923 \u092e\u0947\u0932\u093e \u0915\u094b \u092d\u0947\u0902\u091f \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0917\u094d\u0930\u0939 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, 2024 \u092e\u0947\u0902 \u0936\u0928\u093f \u0928\u0947 \u092e\u0915\u0930 \u0915\u094b \u091b\u0941\u0906, \u0914\u0930 \u0907\u0938 \u0935\u091c\u0939 \u0938\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0938\u093f\u092f\u093e\u0928\u0940 \u0915\u0947 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0906 \u0917\u092f\u093e\u0964\n\n#KumbhMela #Shani #Astrology #\u0938\u094c\u0930\u0928 #\u0917\u094d\u0930\u0939\u0940\u092f\u091a\u0915\u094d\u0930 #\u092d\u0915\u094d\u0924\u093f #\u0907\u0902\u0938\u094d\u092a\u093e\u092f\u0930 #\u0925\u094d\u0930\u093f\u0932",
