{
  "job_id": "20260825-101740-65a42b",
  "title": "\u0915\u0941\u0902\u092d \u0915\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092a\u0930\u0902\u092a\u0930\u093e\u090f\u0902",
  "script": "\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u092e\u0947\u0902 \u0915\u0908 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u094d\u0930\u0935\u091a\u0928, \u092d\u091c\u0928-\u0915\u0940\u0930\u094d\u0924\u0928 \u0914\u0930 \u0935\u093f\u0926\u094d\u0935\u093e\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u093e\u0930\u094d\u0925 \u092d\u0940 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0915\u0908 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0905\u092a\u0928\u0947 \u092a\u0942\u0930\u094d\u0935\u091c\u094b\u0902 \u0915\u094b \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0902\u091c\u0932\u093f \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u093f\u0902\u0921 \u0926\u093e\u0928 \u0915\u0940 \u0930\u0938\u094d\u092e \u092d\u0940 \u0928\u093f\u092d\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u0941\u091b \u0938\u093e\u0927\u0941 \u0915\u0941\u0902\u092d \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0935\u0930\u094d\u0937\u094b\u0902 \u0924\u0915 \u091a\u0932\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0920\u093f\u0928 \u0935\u094d\u0930\u0924 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 - \u091c\u0948\u0938\u0947 \u0915\u092d\u0940 \u0928 \u092c\u0948\u0920\u0928\u093e, \u092f\u093e \u0939\u092e\u0947\u0936\u093e \u090f\u0915 \u0939\u093e\u0925 \u090a\u092a\u0930 \u0909\u0920\u093e\u090f \u0930\u0916\u0928\u093e - \u092d\u0915\u094d\u0924\u093f \u0915\u0947 \u092a\u094d\u0930\u0924\u0940\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u0915\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092a\u0930\u0902\u092a\u0930\u093e\u090f\u0902\n\n\u0936\u093e\u092f\u0926 \u0906\u092a\u0928\u0947 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092f\u0939 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0936\u093e\u0939\u0940 \u0938\u094d\u0928\u093e\u0928 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u092e\u0947\u0902 \u0915\u0908 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u094d\u0930\u0935\u091a\u0928, \u092d\u091c\u0928-\u0915\u0940\u0930\u094d\u0924\u0928 \u0914\u0930 \u0935\u093f\u0926\u094d\u0935\u093e\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u093e\u0930\u094d\u0925 \u092d\u0940 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0915\u0908 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0905\u092a\u0928\u0947 \u092a\u0942\u0930\u094d\u0935\u091c\u094b\u0902 \u0915\u094b \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0902\u091c\u0932\u093f \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u093f\u0902\u0921 \u0926\u093e\u0928 \u0915\u0940 \u0930\u0938\u094d\u092e \u092d\u0940 \u0928\u093f\u092d\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u0941\u091b \u0938\u093e\u0927\u0941 \u0915\u0941\u0902\u092d \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0935\u0930\u094d\u0937\u094b\u0902 \u0924\u0915 \u091a\u0932\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0920\u093f\u0928 \u0935\u094d\u0930\u0924 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 - \u091c\u0948\u0938\u0947 \u0915\u092d\u0940 \u0928 \u092c\u0948\u0920\u0928\u093e, \u092f\u093e \u0939\u092e\u0947\u0936\u093e \u090f\u0915 \u0939\u093e\u0925 \u090a\u092a\u0930 \u0909\u0920\u093e\u090f \u0930\u0916\u0928\u093e - \u092d\u0915\u094d\u0924\u093f \u0915\u0947 \u092a\u094d\u0930\u0924\u0940\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\u0964 \u092f\u0939\u0940 \u0935\u091c\u0939 \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0907\u0902\u0938\u093e\u0928\u0940 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u091c\u092e\u093e\u0935\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0917\u093f\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n#\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915\u0924\u093e #IncredibleIndia #\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f #\u0917\u0902\u0917\u093e #\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e",
