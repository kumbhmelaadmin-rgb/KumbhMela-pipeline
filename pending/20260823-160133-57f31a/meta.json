{
  "job_id": "20260823-160133-57f31a",
  "title": "\u0915\u0941\u0902\u092d \u0915\u0947 \u091a\u093e\u0930 \u092a\u0935\u093f\u0924\u094d\u0930 \u0938\u094d\u0925\u093e\u0928",
  "script": "\u092f\u0939 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0924\u0925\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964 \u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c \u0915\u093e \u0915\u0941\u0902\u092d \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0938\u0902\u0917\u092e \u092a\u0930 \u0939\u094b\u0924\u093e \u0939\u0948 - \u0917\u0902\u0917\u093e, \u092f\u092e\u0941\u0928\u093e \u0914\u0930 \u092a\u094c\u0930\u093e\u0923\u093f\u0915 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0928\u0926\u0940 \u0915\u0947 \u092e\u093f\u0932\u0928 \u0938\u094d\u0925\u0932 \u092a\u0930\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u091a\u093e\u0930 \u092a\u0935\u093f\u0924\u094d\u0930 \u0928\u0926\u093f\u092f\u094b\u0902 \u0915\u0947 \u0924\u091f \u092a\u0930 \u092c\u093e\u0930\u0940-\u092c\u093e\u0930\u0940 \u0938\u0947 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948 - \u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c \u0914\u0930 \u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 \u092e\u0947\u0902 \u0917\u0902\u0917\u093e, \u0909\u091c\u094d\u091c\u0948\u0928 \u092e\u0947\u0902 \u0936\u093f\u092a\u094d\u0930\u093e, \u0914\u0930 \u0928\u093e\u0938\u093f\u0915 \u092e\u0947\u0902 \u0917\u094b\u0926\u093e\u0935\u0930\u0940\u0964 \u0939\u0930 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0941\u0902\u092d \u0932\u0917\u092d\u0917 \u0939\u0930 \u092c\u093e\u0930\u0939 \u0938\u093e\u0932 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930 \u0906\u0924\u093e \u0939\u0948, \u092f\u093e\u0928\u0940 \u090f\u0915 \u091c\u0940\u0935\u0928\u0915\u093e\u0932 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0907\u0938\u0947 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0938\u0947 \u0915\u0941\u091b \u0939\u0940 \u092c\u093e\u0930 \u0926\u0947\u0916 \u092a\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u0915\u0947 \u091a\u093e\u0930 \u092a\u0935\u093f\u0924\u094d\u0930 \u0938\u094d\u0925\u093e\u0928\n\n\u092f\u0939 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0924\u0925\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964 \u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c \u0915\u093e \u0915\u0941\u0902\u092d \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0938\u0902\u0917\u092e \u092a\u0930 \u0939\u094b\u0924\u093e \u0939\u0948 - \u0917\u0902\u0917\u093e, \u092f\u092e\u0941\u0928\u093e \u0914\u0930 \u092a\u094c\u0930\u093e\u0923\u093f\u0915 \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0928\u0926\u0940 \u0915\u0947 \u092e\u093f\u0932\u0928 \u0938\u094d\u0925\u0932 \u092a\u0930\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u091a\u093e\u0930 \u092a\u0935\u093f\u0924\u094d\u0930 \u0928\u0926\u093f\u092f\u094b\u0902 \u0915\u0947 \u0924\u091f \u092a\u0930 \u092c\u093e\u0930\u0940-\u092c\u093e\u0930\u0940 \u0938\u0947 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948 - \u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c \u0914\u0930 \u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 \u092e\u0947\u0902 \u0917\u0902\u0917\u093e, \u0909\u091c\u094d\u091c\u0948\u0928 \u092e\u0947\u0902 \u0936\u093f\u092a\u094d\u0930\u093e, \u0914\u0930 \u0928\u093e\u0938\u093f\u0915 \u092e\u0947\u0902 \u0917\u094b\u0926\u093e\u0935\u0930\u0940\u0964 \u0939\u0930 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0941\u0902\u092d \u0932\u0917\u092d\u0917 \u0939\u0930 \u092c\u093e\u0930\u0939 \u0938\u093e\u0932 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930 \u0906\u0924\u093e \u0939\u0948, \u092f\u093e\u0928\u0940 \u090f\u0915 \u091c\u0940\u0935\u0928\u0915\u093e\u0932 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0907\u0938\u0947 \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0938\u0947 \u0915\u0941\u091b \u0939\u0940 \u092c\u093e\u0930 \u0926\u0947\u0916 \u092a\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\n#\u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f #\u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 #\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e #KumbhMela",
