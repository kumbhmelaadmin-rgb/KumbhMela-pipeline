{
  "job_id": "20260926-193156-005319",
  "title": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0928\u0939\u0940\u0902",
  "script": "\u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 \u0938\u093e\u0932 \u0939\u094b\u0924\u093e \u0939\u0948, \u092a\u0930 \u092f\u0939 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0917\u0932\u0924 \u0939\u0948\u0964 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u091a\u093e\u0930 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u0930 \u092c\u093e\u0930 12 \u0935\u0930\u094d\u0937 \u0915\u0947 \u0905\u0902\u0924\u0930 \u092a\u0930 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0905\u0928\u0915\u0939\u0947 \u0930\u093f\u0926\u092e \u0915\u0947 \u092a\u0940\u091b\u0947 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0914\u0930 \u0927\u0930\u094d\u092e \u0915\u093e \u092e\u0947\u0932 \u0939\u0948\u0964 \u092f\u0947 \u091a\u093e\u0930 \u092e\u0947\u0932\u093e: \u0917\u0902\u0917\u093e, \u092f\u092e\u0941\u0928\u093e, \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0914\u0930 \u0939\u0941\u0917\u0932\u0940, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 12 \u0935\u0930\u094d\u0937 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0924\u0903 \u091c\u092c \u0906\u092a \u092f\u0939 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u0930 \u0935\u0930\u094d\u0937 \u092e\u0947\u0932\u093e \u0939\u0948, \u0924\u094b \u092f\u093e\u0926 \u0930\u0916\u093f\u090f\u2026\u092f\u0939 \u090f\u0915 \u0935\u093f\u0936\u0947\u0937, \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u091a\u0915\u094d\u0930 \u0939\u0948, \u0928 \u0915\u093f \u0938\u093e\u0932\u093e\u0928\u093e \u0906\u092f\u094b\u091c\u0928\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u0928\u0939\u0940\u0902\n\n\u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 \u0938\u093e\u0932 \u0939\u094b\u0924\u093e \u0939\u0948, \u092a\u0930 \u092f\u0939 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0917\u0932\u0924 \u0939\u0948\u0964 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u091a\u093e\u0930 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u0930 \u092c\u093e\u0930 12 \u0935\u0930\u094d\u0937 \u0915\u0947 \u0905\u0902\u0924\u0930 \u092a\u0930 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0905\u0928\u0915\u0939\u0947 \u0930\u093f\u0926\u092e \u0915\u0947 \u092a\u0940\u091b\u0947 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0914\u0930 \u0927\u0930\u094d\u092e \u0915\u093e \u092e\u0947\u0932 \u0939\u0948\u0964 \u092f\u0947 \u091a\u093e\u0930 \u092e\u0947\u0932\u093e: \u0917\u0902\u0917\u093e, \u092f\u092e\u0941\u0928\u093e, \u0938\u0930\u0938\u094d\u0935\u0924\u0940 \u0914\u0930 \u0939\u0941\u0917\u0932\u0940, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 12 \u0935\u0930\u094d\u0937 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0924\u0903 \u091c\u092c \u0906\u092a \u092f\u0939 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u0930 \u0935\u0930\u094d\u0937 \u092e\u0947\u0932\u093e \u0939\u0948, \u0924\u094b \u092f\u093e\u0926 \u0930\u0916\u093f\u090f\u2026\u092f\u0939 \u090f\u0915 \u0935\u093f\u0936\u0947\u0937, \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u091a\u0915\u094d\u0930 \u0939\u0948, \u0928 \u0915\u093f \u0938\u093e\u0932\u093e\u0928\u093e \u0906\u092f\u094b\u091c\u0928\u0964\n\n#\u0915\u0941\u0902\u092d\u092e\u094