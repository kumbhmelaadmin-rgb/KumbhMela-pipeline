{
  "job_id": "20260925-201334-5e2880",
  "title": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u093e \u0916\u0917\u094b\u0932\u0940\u092f \u0930\u0939\u0938\u094d\u092f",
  "script": "\u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0928\u093e \u0915\u0947\u0935\u0932 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0938\u0926\u0940\u092c\u093e\u091c\u093c \u0916\u0917\u094b\u0932\u0940\u092f \u091a\u093e\u0932 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0948? \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0917\u094d\u0930\u0902\u0925\u094b\u0902 \u092e\u0947\u0902 \u0935\u0930\u094d\u0923\u093f\u0924 \u0939\u0948 \u0915\u093f 6 \u0917\u094d\u0930\u0939\u094b\u0902\u2014\u091a\u0902\u0926\u094d\u0930\u092e\u093e, \u0936\u0941\u0915\u094d\u0930, \u092e\u0902\u0917\u0932, \u092c\u0943\u0939\u0938\u094d\u092a\u0924\u093f, \u0936\u0928\u093f \u0914\u0930 \u0938\u0942\u0930\u094d\u092f\u2014\u0915\u0940 \u090f\u0915 \u0905\u0928\u0942\u0920\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0915\u093e\u0930\u0923 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 12 \u0935\u0930\u094d\u0937\u094b\u0902 \u092e\u0947\u0902 \u0915\u0908 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0914\u0930 \u0932\u0915\u094d\u0937\u094d\u092e\u0940 \u0915\u0947 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092c\u093e\u0926, \u0926\u0947\u0935\u0940 \u0917\u0902\u0917\u093e \u0915\u093e \u092a\u0935\u093f\u0924\u094d\u0930 \u091c\u0932 \u092a\u0943\u0925\u094d\u0935\u0940 \u092a\u0930 \u0909\u0924\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093e\u0930\u094b\u0902 \u0924\u0940\u0930\u094d\u0925\u092f\u093e\u0924\u094d\u0930\u0940 \u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0906\u0902\u0915\u0921\u093c\u094b\u0902 \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u091a\u0915\u094d\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u090f\u0935\u0902 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u0915\u0947 \u0938\u0902\u0924\u0941\u0932\u0928 \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0905\u0928\u094b\u0916\u0947 \u092e\u093f\u0936\u094d\u0930\u0923 \u0928\u0947 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u094b \u092e\u0947\u0932\u093e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u093f\u092f\u093e \u0939\u0948\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0915\u093e \u0916\u0917\u094b\u0932\u0940\u092f \u0930\u0939\u0938\u094d\u092f\n\n\u0915\u094d\u092f\u093e \u0906\u092a \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0928\u093e \u0915\u0947\u0935\u0932 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u092a\u094d\u0930\u0924\u0940\u0915 \u0939\u0948, \u092c\u0932\u094d\u0915\u093f \u090f\u0915 \u0938\u0926\u0940\u092c\u093e\u091c\u093c \u0916\u0917\u094b\u0932\u0940\u092f \u091a\u093e\u0932 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u0948? \u092a\u094d\u0930\u093e\u091a\u0940\u0928 \u0917\u094d\u0930\u0902\u0925\u094b\u0902 \u092e\u0947\u0902 \u0935\u0930\u094d\u0923\u093f\u0924 \u0939\u0948 \u0915\u093f 6 \u0917\u094d\u0930\u0939\u094b\u0902\u2014\u091a\u0902\u0926\u094d\u0930\u092e\u093e, \u0936\u0941\u0915\u094d\u0930, \u092e\u0902\u0917\u0932, \u092c\u0943\u0939\u0938\u094d\u092a\u0924\u093f, \u0936\u0928\u093f \u0914\u0930 \u0938\u0942\u0930\u094d\u092f\u2014\u0915\u0940 \u090f\u0915 \u0905\u0928\u0942\u0920\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0915\u093e\u0930\u0923 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0939\u0930 12 \u0935\u0930\u094d\u0937\u094b\u0902 \u092e\u0947\u0902 \u0915\u0908 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0914\u0930 \u0932\u0915\u094d\u0937\u094d\u092e\u0940 \u0915\u0947 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092c\u093e\u0926, \u0926\u0947\u0935\u0940 \u0917\u0902\u0917\u093e \u0915\u093e \u092a\u0935\u093f\u0924\u094d\u0930 \u091c\u0932 \u092a\u0943\u0925\u094d\u0935\u0940 \u092a\u0930 \u0909\u0924\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0939\u091c\u093e\u0930\u094b\u0902 \u0924\u0940\u0930\u094d\u0925\u092f\u093e\u0924\u094d\u0930\u0940 \u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0906\u0902\u0915\u0921\u093c\u094b\u0902 \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u091a\u0915\u094d\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u090f\u0935\u0902 \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u0915\u0947 \u0938\u0902\u0924\u0941\u0932\u0928 \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u0905\u0928\u094b\u0916\u0947 \u092e\u093f\u0936\u094d\u0930\u0923 \u0928\u0947 \u0926\u0941\u0928\u093f\u092f\u093e \u0915\u094b \u092e\u0947\u0932\u093e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u093f\u092f\u093e \u0939\u0948\u0964\n\n#\u0915\u0941\u0902\u092d\u092e\u0947\u0932\u093e #KumbhMela #\u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915\u0927\u0930\u094b\u0939\u0930 #AstronomicalCycle #\u092e\u093e\u0928\u093e\u093e\u0930\u094b\u0939\u0923 #\u0907\u0915\u093e\u0908\u091c\u094d\u092f\u094b\u0924\u093f\u0938 #IndianHeritage",
