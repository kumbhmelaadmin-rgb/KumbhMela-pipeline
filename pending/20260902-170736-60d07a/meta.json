{
  "job_id": "20260902-170736-60d07a",
  "title": "\u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928 \u0915\u0940 \u0915\u0925\u093e",
  "script": "\u092f\u0939 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0924\u0925\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964 \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928 \u0915\u0940 \u0915\u0925\u093e \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0914\u0930 \u0905\u0938\u0941\u0930\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u093f\u0932\u0915\u0930 \u0905\u092e\u0943\u0924 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948\u0964 \u0907\u0938\u0940\u0932\u093f\u090f \u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u093e \u092e\u093e\u0928\u0928\u093e \u0939\u0948 \u0915\u093f \u0907\u0928 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u093e \u0909\u0938\u0940 \u0905\u092e\u0943\u0924 \u091c\u0948\u0938\u093e \u092a\u0935\u093f\u0924\u094d\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0905\u092e\u0943\u0924 \u0915\u0932\u0936 \u0932\u0947 \u091c\u093e\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0925\u093e, \u0924\u094b \u0915\u0941\u091b \u092c\u0942\u0902\u0926\u0947\u0902 \u0927\u0930\u0924\u0940 \u0915\u0940 \u091a\u093e\u0930 \u091c\u0917\u0939\u094b\u0902 \u092a\u0930 \u0917\u093f\u0930\u0940\u0902 - \u0935\u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u091c\u0939\u093e\u0902 \u0906\u091c \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0939\u0948 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 - \u0906\u0938\u094d\u0925\u093e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0910\u0938\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u0924\u0930 \u091c\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0939\u0940\u0902 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964",
  "caption": "\u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928 \u0915\u0940 \u0915\u0925\u093e\n\n\u092f\u0939 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u0938\u092c\u0938\u0947 \u0926\u093f\u0932\u091a\u0938\u094d\u092a \u0924\u0925\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964 \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928 \u0915\u0940 \u0915\u0925\u093e \u0926\u0947\u0935\u0924\u093e\u0913\u0902 \u0914\u0930 \u0905\u0938\u0941\u0930\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u093f\u0932\u0915\u0930 \u0905\u092e\u0943\u0924 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0941\u0926\u094d\u0930 \u092e\u0902\u0925\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 \u0939\u0948\u0964 \u0907\u0938\u0940\u0932\u093f\u090f \u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u093e \u092e\u093e\u0928\u0928\u093e \u0939\u0948 \u0915\u093f \u0907\u0928 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092a\u0930 \u0938\u094d\u0928\u093e\u0928 \u0915\u0930\u0928\u093e \u0909\u0938\u0940 \u0905\u092e\u0943\u0924 \u091c\u0948\u0938\u093e \u092a\u0935\u093f\u0924\u094d\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0905\u092e\u0943\u0924 \u0915\u0932\u0936 \u0932\u0947 \u091c\u093e\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0925\u093e, \u0924\u094b \u0915\u0941\u091b \u092c\u0942\u0902\u0926\u0947\u0902 \u0927\u0930\u0924\u0940 \u0915\u0940 \u091a\u093e\u0930 \u091c\u0917\u0939\u094b\u0902 \u092a\u0930 \u0917\u093f\u0930\u0940\u0902 - \u0935\u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u091c\u0939\u093e\u0902 \u0906\u091c \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u093e \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0939\u0948 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0915\u0939\u093e\u0928\u0940 - \u0906\u0938\u094d\u0925\u093e, \u0907\u0924\u093f\u0939\u093e\u0938 \u0914\u0930 \u0910\u0938\u093e \u092d\u0935\u094d\u092f \u0938\u094d\u0924\u0930 \u091c\u094b \u0926\u0941\u0928\u093f\u092f\u093e \u092e\u0947\u0902 \u0915\u0939\u0940\u0902 \u0914\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e\u0964\n\n#\u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 #\u0917\u0902\u0917\u093e #\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915\u0924\u093e #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e #\u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f",
