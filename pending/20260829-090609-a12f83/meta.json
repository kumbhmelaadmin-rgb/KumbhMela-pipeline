{
  "job_id": "20260829-090609-a12f83",
  "title": "\u0915\u0941\u0902\u092d \u0915\u0947 \u0905\u0916\u093e\u0921\u093c\u0947",
  "script": "\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u0940 \u092c\u093e\u0924 \u091c\u094b \u0936\u093e\u092f\u0926 \u0906\u092a \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u092e\u0947\u0902 \u0905\u0916\u093e\u0921\u093c\u0947 \u0935\u093f\u0936\u093e\u0932 \u0936\u093f\u0935\u093f\u0930 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u090f\u0915 \u0924\u092f \u0915\u094d\u0930\u092e \u092e\u0947\u0902 \u092d\u0935\u094d\u092f \u0936\u094b\u092d\u093e\u092f\u093e\u0924\u094d\u0930\u093e \u0928\u093f\u0915\u093e\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0916\u093e\u0921\u093c\u0947 \u0938\u0926\u093f\u092f\u094b\u0902 \u092a\u0941\u0930\u093e\u0928\u0947 \u0938\u093e\u0927\u0941-\u0938\u0902\u0924\u094b\u0902 \u0915\u0947 \u0938\u0902\u0917\u0920\u093f\u0924 \u0938\u092e\u0942\u0939 \u0939\u0948\u0902, \u0939\u0930 \u090f\u0915 \u0915\u0940 \u0905\u092a\u0928\u0940 \u092a\u0930\u0902\u092a\u0930\u093e, \u0906\u0930\u093e\u0927\u094d\u092f \u0926\u0947\u0935\u0924\u093e \u0914\u0930 \u092a\u0926\u093e\u0928\u0941\u0915\u094d\u0930\u092e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0924\u0947\u0930\u0939 \u092a\u094d\u0930\u092e\u0941\u0916 \u0905\u0916\u093e\u0921\u093c\u0947 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0948\u0902, \u091c\u093f\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u0941\u091b \u0915\u0940 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0906\u0920\u0935\u0940\u0902 \u0938\u0926\u0940 \u0924\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964",
  "caption": "\u0915\u0941\u0902\u092d \u0915\u0947 \u0905\u0916\u093e\u0921\u093c\u0947\n\n\u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u090f\u0915 \u0910\u0938\u0940 \u092c\u093e\u0924 \u091c\u094b \u0936\u093e\u092f\u0926 \u0906\u092a \u0928\u0939\u0940\u0902 \u091c\u093e\u0928\u0924\u0947\u0964 \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u092e\u0947\u0902 \u0905\u0916\u093e\u0921\u093c\u0947 \u0935\u093f\u0936\u093e\u0932 \u0936\u093f\u0935\u093f\u0930 \u0932\u0917\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u090f\u0915 \u0924\u092f \u0915\u094d\u0930\u092e \u092e\u0947\u0902 \u092d\u0935\u094d\u092f \u0936\u094b\u092d\u093e\u092f\u093e\u0924\u094d\u0930\u093e \u0928\u093f\u0915\u093e\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0916\u093e\u0921\u093c\u0947 \u0938\u0926\u093f\u092f\u094b\u0902 \u092a\u0941\u0930\u093e\u0928\u0947 \u0938\u093e\u0927\u0941-\u0938\u0902\u0924\u094b\u0902 \u0915\u0947 \u0938\u0902\u0917\u0920\u093f\u0924 \u0938\u092e\u0942\u0939 \u0939\u0948\u0902, \u0939\u0930 \u090f\u0915 \u0915\u0940 \u0905\u092a\u0928\u0940 \u092a\u0930\u0902\u092a\u0930\u093e, \u0906\u0930\u093e\u0927\u094d\u092f \u0926\u0947\u0935\u0924\u093e \u0914\u0930 \u092a\u0926\u093e\u0928\u0941\u0915\u094d\u0930\u092e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u091c \u0924\u0947\u0930\u0939 \u092a\u094d\u0930\u092e\u0941\u0916 \u0905\u0916\u093e\u0921\u093c\u0947 \u092e\u093e\u0928\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0948\u0902, \u091c\u093f\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u0941\u091b \u0915\u0940 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0906\u0920\u0935\u0940\u0902 \u0938\u0926\u0940 \u0924\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0947 \u0930\u0939\u093f\u090f, \u0915\u0941\u0902\u092d \u092e\u0947\u0932\u0947 \u0915\u0940 \u0914\u0930 \u092d\u0940 \u0905\u0928\u0938\u0941\u0928\u0940 \u092c\u093e\u0924\u0947\u0902 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\n#\u092a\u094d\u0930\u092f\u093e\u0917\u0930\u093e\u091c #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f #\u0917\u0902\u0917\u093e #\u0928\u093e\u0917\u093e\u0938\u093e\u0927\u0941 #\u0939\u0930\u093f\u0926\u094d\u0935\u093e\u0930 #\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915\u0924\u093e",
